#!/bin/bash
# setup hash: {{ $files := list }}{{ $files = concat $files (glob (joinPath .chezmoi.sourceDir "../setup/macos/*.yml")) }}{{ $files = concat $files (list (joinPath .chezmoi.sourceDir "../setup/macos/Brewfile")) }}{{ $files = concat $files (glob (joinPath .chezmoi.sourceDir "../setup/shared/*.yml")) }}{{ $content := "" }}{{ range $files }}{{ $content = print $content (include .) }}{{ end }}{{ $content | sha256sum }}
set -e

cd "{{ .chezmoi.sourceDir }}/../setup"

# Bootstrap: Homebrew is the prerequisite for everything, including Task itself.
if ! command -v brew &>/dev/null; then
  echo "[*] installing homebrew."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
# brew's installer does not touch this process's PATH — load it so `brew`/`task` resolve here.
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Bootstrap Task, then hand the actual setup off to it (idempotent if already installed).
brew install go-task

task -d macos setup
task -d shared setup
