# setup hash: {{ $files := list }}{{ $files = concat $files (glob (joinPath .chezmoi.sourceDir "../setup/windows/*.yml")) }}{{ $files = concat $files (glob (joinPath .chezmoi.sourceDir "../setup/windows/*.ps1")) }}{{ $files = concat $files (glob (joinPath .chezmoi.sourceDir "../setup/shared/*.yml")) }}{{ $content := "" }}{{ range $files }}{{ $content = print $content (include .) }}{{ end }}{{ $content | sha256sum }}
Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

Set-Location "{{ .chezmoi.sourceDir }}\..\setup"

function Update-Path {
  # winget writes new install dirs to the persisted PATH but not to this process's env — reload it.
  $env:Path = [Environment]::GetEnvironmentVariable('Path', 'Machine') + ';' + [Environment]::GetEnvironmentVariable('Path', 'User')
}

# Bootstrap Task (winget ships with Windows, so it needs no bootstrap of its own).
if (-not (Get-Command task -ErrorAction SilentlyContinue)) {
  Write-Host "[*] installing task via winget."
  winget install --id Task.Task -e --source winget --accept-package-agreements --accept-source-agreements
  Update-Path
}

# Hand the actual setup off to Task. $ErrorActionPreference doesn't stop on a native command's
# exit code, so check it — otherwise chezmoi records the run as done and never retries.
task -d windows setup
if ($LASTEXITCODE) { exit $LASTEXITCODE }
Update-Path
task -d shared setup
if ($LASTEXITCODE) { exit $LASTEXITCODE }
